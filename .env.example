# Copy this file to `.env` and fill in real values there.
# `.env` itself is gitignored — never commit real credentials.

# Same RDS instance the PHP version used — same tables, same data.
DB_HOST=
DB_USER=
DB_PASS=
DB_NAME=mystore

# Flask session signing key — generate your own with:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# Leave these at 0 for now (plain HTTP). Set FORCE_HTTPS_COOKIES=1 only
# once this is actually served over HTTPS, or the session cookie won't
# be sent and nobody will be able to log in.
FLASK_DEBUG=0
FORCE_HTTPS_COOKIES=0
